 {"page": "jobs.all", "state": "board", "hash": "jobs", "settle_ms": 1200,
  "_why": "fixup-jobs: Jobs is one real board - in progress here (the bridge's job table), waiting on the cluster (every script the site wrote, GET /api/hpc/cluster), waiting in review (GET /api/review/queues) - with no fixture half and no demo chip",
  "actions": [{"wait_for": ["[data-testid=\"live-local-table\"], [data-testid=\"live-local-empty\"], [data-testid=\"live-local-jobs\"] .error-card", 30000]},
              {"wait_for": ["[data-testid=\"exported-table\"], [data-testid=\"exported-empty\"], [data-testid=\"exported-jobs\"] .error-card", 30000]},
              {"wait_for": ["[data-testid=\"review-table\"], [data-testid=\"review-queues-empty\"], [data-testid=\"review-queues\"] .error-card", 30000]}],
  "expect": ["[data-testid=\"jobs-live\"]", "[data-testid=\"live-local-jobs\"]", "[data-testid=\"exported-jobs\"]", "[data-testid=\"review-queues\"]",
             "[data-testid=\"chip-local\"]", "[data-testid=\"chip-cluster\"]", "[data-testid=\"chip-to-import\"]", "[data-testid=\"chip-review\"]", "[data-testid=\"open-inbox\"]"],
  "expect_absent": ["[data-testid=\"jobs-load-failed\"]", "[data-testid=\"demo-chip\"]", "[data-testid=\"jobs-demo-chip\"]", "[data-testid=\"jobs-table\"]"]},

 {"page": "jobs.all", "state": "local", "hash": "jobs",
  "_why": "the bridge's own job table as the store holds it: its rows when the bridge has run a job, its empty state when not",
  "branch_on": {"api": "/api/jobs?limit=5", "items": "", "empty": {"expect": ["[data-testid=\"live-local-empty\"]"]}, "populated": {"expect": ["[data-testid=\"live-local-table\"]", "[data-testid^=\"live-job-row-\"]"], "expect_absent": ["[data-testid=\"live-local-empty\"]"]}},
  "actions": [{"wait_for": ["[data-testid=\"live-local-table\"], [data-testid=\"live-local-empty\"], [data-testid=\"live-local-jobs\"] .error-card", 15000]}],
  "expect": ["[data-testid=\"live-local-jobs\"]", "[data-testid=\"local-status-filter\"]", "[data-testid=\"live-local-summary\"]"]},

 {"page": "jobs.all", "state": "local-in-progress-only", "hash": "jobs",
  "_why": "the status filter narrows the table to what is in progress; with nothing running the card says so rather than showing finished rows",
  "branch_on": {"api": "/api/jobs?limit=60", "items": "", "where": {"status": "running"}, "empty": {"expect": ["[data-testid=\"live-local-empty\"]"]}, "populated": {"expect": ["[data-testid^=\"live-job-row-\"][data-status=\"running\"]"]}},
  "actions": [{"wait_for": ["[data-testid=\"live-local-table\"], [data-testid=\"live-local-empty\"]", 15000]},
              {"click": "[data-testid=\"local-status-filter\"] button[data-value=\"active\"]"}, {"wait": 300}],
  "expect": ["[data-testid=\"live-local-jobs\"]"]},

 {"page": "jobs.all", "state": "cluster", "hash": "jobs?section=cluster", "settle_ms": 1000,
