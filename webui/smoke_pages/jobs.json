  "actions": [{"wait_for": ["[data-testid=\"exported-table\"], [data-testid=\"exported-empty\"]", 30000]}],
  "expect": ["[data-testid=\"exported-jobs\"]", "[data-testid=\"cluster-filter\"]", "[data-testid=\"cluster-summary\"]"]},

 {"page": "jobs.all", "state": "cluster-row-opened", "hash": "jobs?section=cluster", "settle_ms": 1000,
