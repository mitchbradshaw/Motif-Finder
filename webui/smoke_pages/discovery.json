[
 {
  "page": "discovery.runs",
  "state": "default",
  "hash": "discovery/runs",
  "_why": "ux-1019: runs are hidden in Where each run fires until their eye is on, so the state turns every run on before it expects drawn bins",
  "actions": [
   {
    "wait_for": [
     "[data-testid=\"fires-show-all\"]",
     30000
