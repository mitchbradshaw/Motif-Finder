[{"id":1,"name":"drop_detection_v1","kind":"detection","version":1,"builtin":true,"description":"The canonical drop detector (D1): baseline removal → five-stage encoding with the slope-noise floor → drop detection (candidate onsets, trough, gates, windows). The decomposition of the detector that produced the 410 seed events in DATA/library_seed/drop_motifs5.","created_at":"2026-09-21T16:24:07","updated_at":"2026-09-21T16:24:07","steps":[{"algorithm":"detrend","params":{"mode":"rolling_mean_nearest","window_s":4916.67},"stage":"preprocessing"},{"algorithm":"stage_encoding","params":{"same_fraction":0.6,"segment_seconds":98.33,"slope_sigma":8.0},"stage":"detection"},{"algorithm":"drop_detection","params":{},"stage":"detection"}],"valid":true},{"id":2,"name":"dehshibi_spikes","kind":"detection","version":1,"builtin":true,"description":"Dehshibi & Adamatzky 2021 as three blocks: Morse wavelet transform → Ω summation → Algorithms 1–4. Replaces the monolithic detection.dehshibi_spikes adapter.","created_at":"2026-09-21T16:24:07","updated_at":"2026-09-21T16:24:07","steps":[{"algorithm":"wavelet_transform","params":{},"stage":"preprocessing"},{"algorithm":"wavelet_summation","params":{},"stage":"detection"},{"algorithm":"summation_threshold","params":{},"stage":"detection"}],"valid":true},{"id":3,"name":"mp_threshold","kind":"detection","version":1,"builtin":true,"description":"Baseline → matrix profile → threshold to spans.","created_at":"2026-09-21T16:24:07","updated_at":"2026-09-21T16:24:07","steps":[{"algorithm":"detrend","params":{"mode":"rolling_mean","window_s":600.0},"stage":"preprocessing"},{"algorithm":"matrix_profile","params":{"backend":"stump","window_min":1.0},"stage":"detection"},{"algorithm":"threshold","params":{"threshold":8.0},"stage":"detection"}],"valid":true},{"id":4,"name":"mp_motifs","kind":"detection","version":1,"builtin":true,"description":"Baseline → matrix profile → motif groups (seed + nearest neighbours, labelled by group).","created_at":"2026