# latexmk settings for the manual: `latexmk` in this folder builds build/main.pdf.
# LaTeX Workshop uses the same output folder (.vscode/settings.json).
$pdf_mode = 1;
$out_dir = 'build';
$bibtex_use = 2;
$pdflatex = 'pdflatex -interaction=nonstopmode -file-line-error -synctex=1 %O %S';
@default_files = ('main.tex');
